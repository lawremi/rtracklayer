PKG_CPPFLAGS = $(shell pkg-config --cflags zlib openssl libcurl)
PKG_LIBS += $(shell pkg-config --libs zlib openssl libcurl)

include Makevars.common
OBJECTS = $(PKG_OBJECTS) $(UCSC_OBJECTS:%=ucsc/%)

all: $(SHLIB)

clean:
	rm -f $(OBJECTS)

%.o: %.c
	$(CC) $(ALL_CPPFLAGS) $(ALL_CFLAGS) -c $< -o $@
